{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Security": {
    "AgentId": "",
    "ServerEndpoint": "https://localhost:5001",
    "ClientCertificate": {
      "Source": "File",
      "Path": "certs/agent.pfx"
    },
    "TrustedCa": {
      "Source": "File",
      "Path": "certs/ca.crt"
    },
    "SigningPublicKeys": {
      "dev": "certs/signing-public.pem"
    },
    "ClockSkewSeconds": 60,
    "MaxCommandLifetimeSeconds": 300,
    "Executor": {
      "Mode": "DryRun",
      "TimeoutSeconds": 60
    }
  }
}
